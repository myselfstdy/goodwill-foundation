generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DONOR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  DEMO_CARD
  DEMO_BANK
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  email                  String                     @unique @db.VarChar(255)
  passwordHash           String                     @db.VarChar(255)
  role                   Role                       @default(DONOR)
  active                 Boolean                    @default(true)
  tokenVersion           Int                        @default(0)
  name                   String                     @db.VarChar(160)
  avatarUrl              String?                    @db.Text
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  donor                  Donor?
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  preferences            DonorPreferences?
  savedCampaigns         SavedCampaign[]
  followedCampaigns      CampaignFollow[]
  loginActivity          LoginActivity[]
  deletionRequests       AccountDeletionRequest[]
  dashboardPreferences   DonorDashboardPreferences?
  supportTickets         SupportTicket[]
  supportTicketReplies   SupportTicketReply[]
  emailVerifications     EmailVerification[]
  passwordResets         PasswordReset[]

  @@index([role])
}

model Donor {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String?            @unique @db.Uuid
  email        String             @db.VarChar(255)
  name         String             @db.VarChar(160)
  phone        String?            @db.VarChar(40)
  address      String?            @db.VarChar(300)
  anonymous    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  donations    Donation[]
  achievements DonorAchievement[]
  savedBy      SavedCampaign[]
  followedBy   CampaignFollow[]
  updates      CampaignUpdate[]

  @@index([email])
  @@index([name])
}

model Campaign {
  id              String           @id @default(uuid()) @db.Uuid
  title           String           @db.VarChar(160)
  slug            String           @unique @db.VarChar(180)
  description     String           @db.Text
  category        String           @db.VarChar(80)
  target          Decimal          @db.Decimal(12, 2)
  startsAt        DateTime
  endsAt          DateTime
  status          CampaignStatus   @default(DRAFT)
  imageUrl        String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  donations       Donation[]
  savedCampaigns  SavedCampaign[]
  campaignFollows CampaignFollow[]
  campaignUpdates CampaignUpdate[]

  @@index([status, endsAt])
}

model Donation {
  id             String           @id @default(uuid()) @db.Uuid
  campaignId     String           @db.Uuid
  donorId        String?          @db.Uuid
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @default("INR") @db.Char(3)
  status         DonationStatus   @default(PENDING)
  anonymous      Boolean          @default(false)
  message        String?          @db.VarChar(500)
  idempotencyKey String?          @unique @db.VarChar(100)
  transactionRef String?          @unique @db.VarChar(80)
  createdAt      DateTime         @default(now())
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  donor          Donor?           @relation(fields: [donorId], references: [id], onDelete: SetNull)
  attempts       PaymentAttempt[]
  receipt        Receipt?

  @@index([campaignId, status])
  @@index([donorId, createdAt])
  @@index([createdAt])
}

model PaymentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  donationId    String        @db.Uuid
  attemptNumber Int
  status        PaymentStatus
  method        PaymentMethod @default(DEMO_CARD)
  reference     String        @unique @db.VarChar(80)
  message       String?       @db.VarChar(300)
  createdAt     DateTime      @default(now())
  donation      Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@unique([donationId, attemptNumber])
  @@index([createdAt])
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  donationId    String   @unique @db.Uuid
  receiptNumber String   @unique @db.VarChar(80)
  issuedAt      DateTime @default(now())
  donation      Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?   @db.VarChar(300)
  ipAddress String?   @db.VarChar(80)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(160)
  message   String    @db.VarChar(500)
  category  String    @default("GENERAL") @db.VarChar(30)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model DonorPreferences {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  preferredAmount   Decimal?      @db.Decimal(12, 2)
  preferredCategory String?       @db.VarChar(80)
  anonymousDefault  Boolean       @default(false)
  paymentMethod     PaymentMethod @default(DEMO_CARD)
  privateProfile    Boolean       @default(false)
  donationMessage   String?       @db.VarChar(500)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedCampaign {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  campaignId String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor      Donor?   @relation(fields: [donorId], references: [id])
  donorId    String?  @db.Uuid

  @@unique([userId, campaignId])
  @@index([userId, createdAt])
}

model CampaignFollow {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  campaignId String   @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor      Donor?   @relation(fields: [donorId], references: [id])
  donorId    String?  @db.Uuid

  @@unique([userId, campaignId])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @unique @db.Uuid
  donationUpdates Boolean @default(true)
  receiptUpdates  Boolean @default(true)
  campaignUpdates Boolean @default(true)
  securityAlerts  Boolean @default(true)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AchievementBadge {
  id           String             @id @default(uuid()) @db.Uuid
  key          String             @unique @db.VarChar(60)
  name         String             @db.VarChar(100)
  description  String             @db.VarChar(300)
  criteria     Json
  active       Boolean            @default(true)
  achievements DonorAchievement[]
}

model DonorAchievement {
  id        String           @id @default(uuid()) @db.Uuid
  donorId   String           @db.Uuid
  badgeId   String           @db.Uuid
  awardedAt DateTime         @default(now())
  donor     Donor            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  badge     AchievementBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([donorId, badgeId])
  @@index([donorId, awardedAt])
}

model SupportTicket {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  subject   String               @db.VarChar(180)
  category  String               @db.VarChar(40)
  status    String               @default("OPEN") @db.VarChar(20)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   SupportTicketReply[]

  @@index([userId, createdAt])
}

model SupportTicketReply {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  userId    String?       @db.Uuid
  body      String        @db.VarChar(3000)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model LoginActivity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(40)
  userAgent String?  @db.VarChar(300)
  ipAddress String?  @db.VarChar(80)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AccountDeletionRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  reason      String?   @db.VarChar(500)
  status      String    @default("PENDING") @db.VarChar(20)
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CampaignUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  title      String   @db.VarChar(160)
  body       String   @db.VarChar(3000)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor      Donor?   @relation(fields: [donorId], references: [id])
  donorId    String?  @db.Uuid

  @@index([campaignId, createdAt])
}

model DonorDashboardPreferences {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @db.Uuid
  preferences Json   @default("{}")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  email     String    @db.VarChar(255)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
